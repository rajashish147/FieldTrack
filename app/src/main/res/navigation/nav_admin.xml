<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_admin"
    app:startDestination="@id/employeeListFragment">

    <fragment
        android:id="@+id/employeeListFragment"
        android:name="com.fieldtrack.app.ui.admin.EmployeeListFragment"
        android:label="@string/employees"
        tools:layout="@layout/fragment_employee_list">

        <!-- v1.4 - Navigate to per-employee session history -->
        <action
            android:id="@+id/action_employeeList_to_sessionHistory"
            app:destination="@id/employeeSessionHistoryFragment" />

    </fragment>

    <fragment
        android:id="@+id/unifiedApprovalsFragment"
        android:name="com.fieldtrack.app.ui.admin.UnifiedApprovalsFragment"
        android:label="@string/approvals"
        tools:layout="@layout/fragment_unified_approvals" />

    <fragment
        android:id="@+id/liveTrackingFragment"
        android:name="com.fieldtrack.app.ui.admin.LiveTrackingFragment"
        android:label="@string/live_tracking"
        tools:layout="@layout/fragment_live_tracking">

        <action
            android:id="@+id/action_liveTracking_to_employeeMap"
            app:destination="@id/employeeMapFragment" />

        <!-- v1.4 - Navigate to per-employee session history from Live Tracking -->
        <action
            android:id="@+id/action_liveTracking_to_adminSessionHistory"
            app:destination="@id/adminSessionHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/employeeMapFragment"
        android:name="com.fieldtrack.app.ui.admin.EmployeeMapFragment"
        android:label="Employee Location"
        tools:layout="@layout/fragment_employee_map">

        <argument android:name="userId" app:argType="string" />
        <argument android:name="name" app:argType="string" />
        <argument android:name="latitude" app:argType="float" android:defaultValue="0" />
        <argument android:name="longitude" app:argType="float" android:defaultValue="0" />
        <argument android:name="lastUpdated" app:argType="string" android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/adminExpenseFragment"
        android:name="com.fieldtrack.app.ui.admin.AdminExpenseFragment"
        android:label="Expenses"
        tools:layout="@layout/fragment_admin_expense" />

    <!-- P2.1 - Admin Open Sessions -->
    <fragment
        android:id="@+id/openSessionsFragment"
        android:name="com.fieldtrack.app.ui.admin.OpenSessionsFragment"
        android:label="Open Sessions"
        tools:layout="@layout/fragment_open_sessions">

        <action
            android:id="@+id/action_openSessions_to_sessionRoute"
            app:destination="@id/sessionRouteFragment" />
    </fragment>

    <!-- v1.4 - Admin Session History (entry from Live Tracking) -->
    <fragment
        android:id="@+id/adminSessionHistoryFragment"
        android:name="com.fieldtrack.app.ui.admin.AdminSessionHistoryFragment"
        android:label="Session History"
        tools:layout="@layout/fragment_admin_session_history">

        <!-- Required: target employee UUID, read via SafeArgs -->
        <argument
            android:name="userId"
            app:argType="string" />

        <!-- Optional: employee display name for the screen header -->
        <argument
            android:name="employeeName"
            app:argType="string"
            android:defaultValue="" />

        <action
            android:id="@+id/action_adminSessionHistory_to_adminSessionRoute"
            app:destination="@id/adminSessionRouteFragment" />
    </fragment>

    <!-- v1.4 - Admin Session Route (map view, reached from session history) -->
    <fragment
        android:id="@+id/adminSessionRouteFragment"
        android:name="com.fieldtrack.app.ui.admin.AdminSessionRouteFragment"
        android:label="Session Route"
        tools:layout="@layout/fragment_admin_session_route">

        <!--
            Key must be "session_id" (underscore) to match
            AdminSessionRouteFragment.ARG_SESSION_ID = "session_id".
            SafeArgs exposes this as the camelCase parameter sessionId
            in AdminSessionHistoryFragmentDirections, but writes the
            bundle key as "session_id" so the existing fragment reads
            it correctly without modification.
        -->
        <argument
            android:name="session_id"
            app:argType="string" />
    </fragment>

    <!-- Phase 2 Beta - Session Route Visualization -->
    <fragment
        android:id="@+id/sessionRouteFragment"
        android:name="com.fieldtrack.app.ui.route.SessionRouteFragment"
        android:label="Session Route"
        tools:layout="@layout/fragment_session_route">

        <argument
            android:name="sessionId"
            app:argType="string" />

        <!-- Admin fix: optional userId so admins can view employee routes -->
        <argument
            android:name="userId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- v1.4 - Admin Session History -->
    <fragment
        android:id="@+id/employeeSessionHistoryFragment"
        android:name="com.fieldtrack.app.ui.admin.EmployeeSessionHistoryFragment"
        android:label="Session History"
        tools:layout="@layout/fragment_employee_session_history">

        <!-- Required: target employee UUID -->
        <argument
            android:name="userId"
            app:argType="string" />

        <!-- Optional: employee display name shown in the header -->
        <argument
            android:name="employeeName"
            app:argType="string"
            android:defaultValue="" />

        <action
            android:id="@+id/action_sessionHistory_to_sessionRoute"
            app:destination="@id/sessionRouteFragment" />
    </fragment>

</navigation>
