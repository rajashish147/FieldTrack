<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_employee"
    app:startDestination="@id/attendanceFragment">

    <fragment
        android:id="@+id/attendanceFragment"
        android:name="com.fieldtrack.app.ui.employee.AttendanceFragment"
        android:label="@string/attendance"
        tools:layout="@layout/fragment_attendance">

        <action
            android:id="@+id/action_attendanceFragment_to_sessionRoute"
            app:destination="@id/sessionRouteFragment" />
    </fragment>

    <fragment
        android:id="@+id/myLocationFragment"
        android:name="com.fieldtrack.app.ui.employee.MyLocationFragment"
        android:label="@string/my_location"
        tools:layout="@layout/fragment_my_location" />

    <fragment
        android:id="@+id/employeeExpenseFragment"
        android:name="com.fieldtrack.app.ui.expense.ExpenseFragment"
        android:label="@string/expenses"
        tools:layout="@layout/fragment_expense" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.fieldtrack.app.ui.employee.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <!-- Phase 2 Beta - Session Route Visualization -->
    <fragment
        android:id="@+id/sessionRouteFragment"
        android:name="com.fieldtrack.app.ui.route.SessionRouteFragment"
        android:label="My Route"
        tools:layout="@layout/fragment_session_route">

        <argument
            android:name="sessionId"
            app:argType="string" />
    </fragment>

</navigation>
