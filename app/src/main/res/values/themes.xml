<resources>
    <!--
      Base app theme — Compose-only (no XML Material components).
      Edge-to-edge: transparent status + nav bars (Compose handles insets).
    -->
    <style name="Theme.FieldTrack" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Disable default window background to prevent flash on cold start -->
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Splash / launch theme: shown by OS before setContent() runs -->
    <style name="Theme.FieldTrack.Splash" parent="Theme.FieldTrack">
        <!-- Indigo background matches our SplashScreen composable -->
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
