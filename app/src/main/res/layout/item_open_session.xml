<?xml version="1.0" encoding="utf-8"?>
<!-- P2.1 - Admin Open Sessions -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:contentPadding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Employee Name -->
        <TextView
            android:id="@+id/tv_employee_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Email -->
        <TextView
            android:id="@+id/tv_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/on_surface_variant"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Check-in Time and Duration Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_check_in_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@color/on_surface_variant"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/status_approved"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- P2.2 - Force Check-Out Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_force_checkout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="Force Check-Out"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.TextButton"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:iconSize="16dp" />

        <!-- Phase 2 Beta - View Route Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="View Route"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.TextButton"
            app:icon="@android:drawable/ic_menu_mapmode"
            app:iconSize="16dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
